# Taskwarrior per-project database (managed by Forge, not committed)
.task/

# Taskwarrior per-tree config (generated by taskwarrior/setup.sh, mode-specific).
# Must never be committed: a worktree copy would overwrite the main tree's UDAs
# when the epic branch is merged.
.taskrc

# Epic worktrees (parallel execution, not committed)
.worktrees/

# Common build output
build/
