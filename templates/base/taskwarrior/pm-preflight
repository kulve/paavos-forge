#!/bin/bash
# PM preflight check: report status of all epics, Coordinator locks, and active phase tasks.
# Read-only. Prints structured status for PM decision-making.
# Usage: pm-preflight
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/guard.sh"
require_context main

echo "=== PM Preflight ==="
echo ""

# PM lock status
PM_ACTIVE=$(task +AI_LOCK airole:pm +ACTIVE count 2>/dev/null || echo "0")
echo "PM Lock: $([ "$PM_ACTIVE" -gt 0 ] && echo 'HELD' || echo 'FREE')"

# Merge gate
GATE_ACTIVE=$(task +MERGE_GATE +ACTIVE count 2>/dev/null || echo "0")
echo "Merge Gate: $([ "$GATE_ACTIVE" -gt 0 ] && echo 'HELD' || echo 'FREE')"

# Epic summary
echo ""
echo "--- Epics ---"
EPIC_COUNT=$(task aiepic.any: count 2>/dev/null || echo "0")
if [ "$EPIC_COUNT" -gt 0 ]; then
    task aiepic.any: export 2>/dev/null | python3 -c "
import sys, json
tasks = json.load(sys.stdin)
for t in sorted(tasks, key=lambda x: x.get('aiepic', '')):
    print(f\"  {t.get('aiepic','?')}: {t.get('epicstate','?')} - {t.get('description','')}\")
" 2>/dev/null
else
    echo "  No epics registered."
fi

# Per-worktree Coordinator lock, liveness, and progress.
# Exit code is intentionally ignored here: preflight reports, it does not decide.
# Call coordinator-status directly when you need its 0/1/2 verdict.
echo ""
bash "${AI_ROOT}/taskwarrior/coordinator-status" || true

echo ""
echo "=== Preflight Complete ==="
