#!/bin/bash
# Transition a phase task to a new aistate. Validates the transition is legal.
# Usage: phase-transition <task-id> <new-state>
# Legal transitions: plan→plan-review, plan-review→write, plan-review→plan (reject),
#                    write→review, review→done, review→write (reject)
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/guard.sh"
require_context worktree

if [ $# -lt 2 ]; then
    echo "Usage: phase-transition <task-id> <new-state>"
    exit 2
fi

TASK_ID="$1"
NEW_STATE="$2"

CURRENT_STATE=$(task "$TASK_ID" export | python3 -c "import sys,json; d=json.load(sys.stdin); print(d[0].get('aistate',''))" 2>/dev/null)

validate_transition() {
    case "$CURRENT_STATE→$NEW_STATE" in
        "plan→plan-review") return 0 ;;
        "plan-review→write") return 0 ;;
        "plan-review→plan") return 0 ;;
        "write→review") return 0 ;;
        "review→done") return 0 ;;
        "review→write") return 0 ;;
        "blocked→plan") return 0 ;;
        "blocked→plan-review") return 0 ;;
        "blocked→write") return 0 ;;
        "blocked→review") return 0 ;;
        *) return 1 ;;
    esac
}

if ! validate_transition; then
    echo "ERROR: Illegal transition $CURRENT_STATE → $NEW_STATE for task $TASK_ID."
    exit 2
fi

task "$TASK_ID" modify "aistate:$NEW_STATE"
# shellcheck disable=SC2046  # word splitting is intended: three key=value args
ai_heartbeat state $(ai_task_fields "$TASK_ID")
echo "OK: Task $TASK_ID transitioned $CURRENT_STATE → $NEW_STATE."
