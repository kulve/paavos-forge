# Per-project Taskwarrior config (AI execution framework).
# Generated by taskwarrior/setup.sh into <tree-root>/.taskrc -- do not commit.
# Mode-specific UDAs are appended by setup.sh --main or setup.sh --worktree.
# An absolute data.location is appended at generation time; TASKDATA (exported by
# taskwarrior/env.sh) also pins the database so it never depends on the caller's cwd.
# Use via taskwarrior/tw (never bare task).
news=off
confirmation=off
# Default verbosity minus the `override` token, so TASKRC/TASKDATA notices do not
# appear on every call, and minus `filter`/`new-uuid`, which break ID parsing and
# add noise. `new-id` must stay: story-init parses "Created task N".
verbose=blank,header,footnote,label,new-id,affected,edit,special,project,sync,unwait,recur
