#!/bin/bash
# Acquire the Coordinator singleton lock in the current worktree's TW database.
# Exits 1 if already held.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/env.sh"

COORD_ACTIVE=$(task +AI_LOCK airole:coordinator +ACTIVE count 2>/dev/null || echo "0")
if [ "$COORD_ACTIVE" -gt 0 ]; then
    echo "ERROR: Coordinator lock already held in this worktree."
    task +AI_LOCK airole:coordinator export
    exit 1
fi

COORD_ID=$(task +AI_LOCK airole:coordinator ids 2>/dev/null | awk '{print $1}')
if [ -z "$COORD_ID" ]; then
    echo "ERROR: Coordinator lock task not found. Run: bash taskwarrior/setup.sh --worktree"
    exit 2
fi

task "$COORD_ID" start
echo "OK: Coordinator lock acquired (task $COORD_ID)."
