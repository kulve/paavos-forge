#!/bin/bash
# Release the PM singleton lock.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/guard.sh"
require_context main

PM_ID=$(task +AI_LOCK airole:pm +ACTIVE ids 2>/dev/null | awk '{print $1}')
if [ -z "$PM_ID" ]; then
    echo "OK: PM lock not held (nothing to release)."
    exit 0
fi

task "$PM_ID" stop
echo "OK: PM lock released (task $PM_ID)."
