#!/bin/bash
# Verify every phase of a story is done. Optionally runs the test suite.
# A full story has 4 phase tasks; a light story (story-init --rigor light) has 1.
# Usage: story-complete <story-id> [--run-tests]
# Exit 0: all done (and tests pass if --run-tests). Exit 1: not all done. Exit 2: tests fail.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/guard.sh"
require_context worktree

if [ $# -lt 1 ]; then
    echo "Usage: story-complete <story-id> [--run-tests]"
    exit 2
fi

STORY_ID="$1"
RUN_TESTS="${2:-}"

PENDING=$(task "aistory:$STORY_ID" status:pending count 2>/dev/null || echo "0")
COMPLETED=$(task "aistory:$STORY_ID" status:completed count 2>/dev/null || echo "0")

if [ "$PENDING" -gt 0 ]; then
    echo "ERROR: Story $STORY_ID has $PENDING pending tasks."
    task "aistory:$STORY_ID" status:pending list
    exit 1
fi

case "$COMPLETED" in
    4) RIGOR="full" ;;
    1) RIGOR="light" ;;
    *)
        echo "WARNING: Story $STORY_ID has $COMPLETED completed tasks (expected 4 for a full story, 1 for a light one)."
        RIGOR="unknown" ;;
esac

if [ "$RUN_TESTS" = "--run-tests" ]; then
    PROFILE="${AI_ROOT}/ai-framework/project-profile.md"
    if [ -f "$PROFILE" ]; then
        # The command lives inline on the "Run all tests:" line of the profile.
        RAW=$(grep -i "^- *Run all tests:" "$PROFILE" | head -1 | sed 's/^[^:]*:[[:space:]]*//' | sed 's/`//g' || true)
        case "$RAW" in
            "["*) TEST_CMD="" ;;  # unfilled placeholder, e.g. "[e.g. cargo test]"
            *)    TEST_CMD="$RAW" ;;
        esac
        if [ -n "$TEST_CMD" ]; then
            echo "Running tests: $TEST_CMD"
            if ! eval "$TEST_CMD"; then
                echo "ERROR: Test suite failed for story $STORY_ID."
                exit 2
            fi
        else
            echo "WARNING: Could not extract test command from project profile."
        fi
    fi
fi

ai_heartbeat story-verified "story=${STORY_ID}"
echo "OK: Story $STORY_ID complete ($COMPLETED tasks done, rigor=${RIGOR})."
