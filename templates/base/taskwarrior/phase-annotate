#!/bin/bash
# Add a validated annotation to a phase task.
# Usage: phase-annotate <task-id> <prefix> <value>
# Valid prefixes: Plan, Artifact, Deleted, Test fix, Verification, Feedback,
#                 Review, Escalation, Recovery
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/guard.sh"
require_context worktree

if [ $# -lt 3 ]; then
    echo "Usage: phase-annotate <task-id> <prefix> <value>"
    exit 2
fi

TASK_ID="$1"
PREFIX="$2"
shift 2
VALUE="$*"

VALID_PREFIXES="Plan|Artifact|Deleted|Test fix|Verification|Feedback|Review|Escalation|Recovery"
if ! echo "$PREFIX" | grep -qE "^($VALID_PREFIXES)$"; then
    echo "ERROR: Invalid prefix '$PREFIX'. Valid: $VALID_PREFIXES"
    exit 2
fi

task "$TASK_ID" annotate "${PREFIX}: ${VALUE}"
# shellcheck disable=SC2046  # word splitting is intended: three key=value args
ai_heartbeat annotate $(ai_task_fields "$TASK_ID") "detail=${PREFIX}"
echo "OK: Task $TASK_ID annotated with '${PREFIX}: ${VALUE}'."
