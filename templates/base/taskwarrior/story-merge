#!/bin/bash
# Squash-merge a completed story branch into the epic branch (within the worktree).
# Usage: story-merge <story-id> <slug>
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/guard.sh"
require_context worktree

if [ $# -lt 2 ]; then
    echo "Usage: story-merge <story-id> <slug>"
    exit 2
fi

STORY_ID="$1"
SLUG="$2"
STORY_BRANCH="story/${STORY_ID}-${SLUG}"

CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$CURRENT_BRANCH" != "$STORY_BRANCH" ]; then
    echo "ERROR: Not on story branch. Current: $CURRENT_BRANCH, expected: $STORY_BRANCH"
    exit 2
fi

# Bind to this worktree's epic. Never resolve via git decorations or branch order.
EPIC_BRANCH="$(expected_epic_branch)"

git checkout "$EPIC_BRANCH"
HEAD_AFTER=$(git rev-parse --abbrev-ref HEAD)
if [ "$HEAD_AFTER" != "$EPIC_BRANCH" ]; then
    echo "ERROR: After checkout, HEAD is '${HEAD_AFTER}', expected '${EPIC_BRANCH}'."
    exit 2
fi

git merge --squash "$STORY_BRANCH"
git commit -m "story: ${STORY_ID}-${SLUG}"
# Squash does not make the story tip an ancestor of the epic tip, so -d would
# refuse; the squash commit is the durable record — force-delete the story branch.
git branch -D "$STORY_BRANCH"

ai_heartbeat story-merged "story=${STORY_ID}"
echo "OK: Story $STORY_ID merged into $EPIC_BRANCH."
