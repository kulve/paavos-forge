#!/bin/bash
# Stop a phase task (clear +ACTIVE).
# Usage: phase-stop <task-id>
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/guard.sh"
require_context worktree

if [ $# -lt 1 ]; then
    echo "Usage: phase-stop <task-id>"
    exit 2
fi

TASK_ID="$1"
task "$TASK_ID" stop
# shellcheck disable=SC2046  # word splitting is intended: three key=value args
ai_heartbeat phase-stop $(ai_task_fields "$TASK_ID")
echo "OK: Task $TASK_ID stopped."
