#!/bin/bash
# Start a phase task (mark it +ACTIVE). Guards against another task already being active.
# Usage: phase-start <task-id>
# Exit 0: success. Exit 1: another task active. Exit 2: error.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/env.sh"

if [ $# -lt 1 ]; then
    echo "Usage: phase-start <task-id>"
    exit 2
fi

TASK_ID="$1"

ACTIVE_COUNT=$(task +ACTIVE -AI_LOCK count 2>/dev/null || echo "0")
if [ "$ACTIVE_COUNT" -gt 0 ]; then
    echo "ERROR: Another phase task is already active."
    task +ACTIVE -AI_LOCK export
    exit 1
fi

task "$TASK_ID" start
echo "OK: Task $TASK_ID started."
