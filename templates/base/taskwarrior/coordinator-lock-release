#!/bin/bash
# Release the Coordinator singleton lock in the current worktree's TW database.
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/guard.sh"
require_context worktree

COORD_ID=$(task +AI_LOCK airole:coordinator +ACTIVE ids 2>/dev/null | awk '{print $1}')
if [ -z "$COORD_ID" ]; then
    echo "OK: Coordinator lock not held (nothing to release)."
    exit 0
fi

task "$COORD_ID" stop
ai_heartbeat stopped
echo "OK: Coordinator lock released (task $COORD_ID)."
